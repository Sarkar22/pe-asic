# pe_shift.sv's send run length never saturates at 7 (tx_rl.sv). Run with sby in the image formal/README.md uses:
#   sby -f tx_rl.sby prove; sby -f tx_rl.sby cover
[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 12
cover: mode cover
cover: depth 24

[engines]
smtbmc bitwuzla

[script]
read_slang --top pe_shift pe_shift.sv
prove: read_verilog -formal -sv tx_rl.sv
cover: read_verilog -formal -sv -DCOVER tx_rl.sv
hierarchy -top tx_rl
proc
flatten
cd tx_rl
script probes.ys
cd ..

[files]
../../src/pe_shift.sv
tx_rl.sv
probes.ys
