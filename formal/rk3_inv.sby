# J', the bounds of 5.9.6's Period bullet, is inductive on the code of 5.9.6 (rk3_code.sv): it holds in every state a
# reception of RKIND 3 reaches, for every p, RGAIN, RACQ and RDIFF and any input in every cycle (rk3_inv.sv). The
# covers show its bounds are reached.
[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 8
cover: mode cover
cover: depth 40

[engines]
smtbmc bitwuzla

[script]
read_slang -D FORMAL --top rk3_inv rk3_inv.sv rk3_code.sv
prep -top rk3_inv

[files]
rk3_inv.sv
rk3_code.sv
