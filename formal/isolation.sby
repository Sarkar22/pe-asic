# Thread pin isolation: sections 5.3, 5.4, 5.9 and 9.3, the rule in isolation.sv.
[tasks]
prove
cover
bmc

[options]
prove: mode prove
prove: depth 3
cover: mode cover
cover: depth 11
bmc: mode bmc
bmc: depth 25

[engines]
smtbmc bitwuzla

[script]
script read_chip.ys
read_verilog -formal -sv isolation.sv
hierarchy -top isolation
proc
flatten
cd isolation
script probes_pins.ys
script probes_iso.ys
cover: script cut_host.ys
bmc: script cut_host.ys
cd ..

[files]
../src/project.sv
../src/pe_pkg.sv
../src/pe_decode.sv
../src/pe_core.sv
../src/pe_thread.sv
../src/pe_exec.sv
../src/pe_regfile.sv
../src/pe_mailbox.sv
../src/pe_pins.sv
../src/pe_shift.sv
../src/pe_mem.sv
../src/pe_host.sv
../src/pe_spi.sv
../verif/cells_rtl.v
sram_free.v
read_chip.ys
probes_pins.ys
probes_iso.ys
cut_host.ys
isolation.sv
